{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:http": "vitest run test/http",
    "prisma:generate": "dotenv run -f src/.env -- prisma generate",
    "prisma:push": "dotenv run -f src/.env -- prisma db push",
    "prisma:migrate": "dotenv run -f src/.env -- prisma migrate dev",
    "prisma:studio": "dotenv run -f src/.env -- prisma studio",
    "prisma:seed": "dotenv run -f src/.env -- node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "googleapis": "^182.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.12",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
